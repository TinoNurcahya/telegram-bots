# ==============================================================================
# 🎵 Music Discovery & Audio Downloader Bot - Environment Configuration
# ==============================================================================

# [REQUIRED] Telegram Bot Token from @BotFather (https://t.me/BotFather)
BOT_TOKEN=

# [OPTIONAL] Neon PostgreSQL Connection URL
# If left empty, the bot automatically falls back to the built-in In-Memory repository.
# Recommended for Vercel Serverless production deployment:
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# [SECURITY] Secret token for Telegram Webhook verification (header: x-telegram-bot-api-secret-token)
# Highly recommended for Vercel Serverless deployment to prevent unauthorized requests.
WEBHOOK_SECRET=my_music_bot_secret_token

# [OPTIONAL] Public Webhook URL (Used when registering webhook with Telegram API)
# Example: https://music-downloader-bot.vercel.app/api/index
WEBHOOK_URL=https://your-music-bot.vercel.app/api/index

# [OPTIONAL] Node Environment ('development' or 'production')
NODE_ENV=development

# [OPTIONAL] Telegram User ID for Admin dashboard (/stats command)
# Example: 123456789 (leave 0/empty to allow any user to run /stats during dev)
ADMIN_ID=
