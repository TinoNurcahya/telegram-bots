# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Gemini Model Name (Recommended: gemini-2.0-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Bot Execution Mode: 'polling' or 'webhook'
BOT_MODE=polling

# SQLite Database Storage File (used when DATABASE_URL is not set)
DATABASE_PATH=speaking_coach.db

# PostgreSQL Connection URL (Leave empty to use SQLite, or use free Neon.tech for Vercel/Production)
# Example Neon.tech: postgresql://neondb_owner:password@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Redis Queue Connection URL for Arq background worker (Leave empty for In-Process fallback)
# REDIS_URL=redis://localhost:6379/0

# Webhook Configuration (Active when deployed to Vercel or BOT_MODE=webhook)
WEBHOOK_URL=https://your-project.vercel.app/api/index
WEBHOOK_PATH=/api/index
WEBHOOK_SECRET=your_secure_random_32_character_token_here
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
