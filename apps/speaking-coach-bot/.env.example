# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Multimodal Model (Recommended: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Bot Execution Mode: 'polling' (local dev) or 'webhook' (Vercel serverless / cloud)
BOT_MODE=polling

# SQLite Database Storage File (used when DATABASE_URL is empty)
DATABASE_PATH=speaking_coach.db

# PostgreSQL Connection URL (Leave empty to use local SQLite, or use Neon.tech for Vercel/Production)
# Recommended Neon endpoint (with connection pooler):
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Redis Queue Connection URL for Arq background worker (Leave empty for In-Process fallback)
# REDIS_URL=redis://localhost:6379/0

# Webhook Configuration (Active when deployed to Vercel or BOT_MODE=webhook)
WEBHOOK_URL=
WEBHOOK_PATH=/api/index
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000

