# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Target Telegram Chat ID / Channel ID where daily automated Shorts will be posted
# (You can obtain this by starting the bot and sending /status or /id)
TARGET_CHAT_ID=123456789

# Daily Automation Scheduler
ENABLE_DAILY_SCHEDULER=true
DAILY_SCHEDULE_TIME="08:00"
SCHEDULER_TIMEZONE="Asia/Jakarta"

# Voiceover Configuration (Edge-TTS)
# Options: en-US-ChristopherNeural (male energetic), en-US-JennyNeural (female clear), en-US-GuyNeural, en-GB-RyanNeural
VOICE_NAME="en-US-ChristopherNeural"
VOICE_RATE="+0%"
VOICE_PITCH="+0Hz"

# Video Specifications (Fast vertical HD 720x1280 @ 24fps or Full HD 1080x1920 @ 30fps)
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
FPS=24
MAX_SCENE_COUNT=6
MIN_SCENE_DURATION=5.0

# Optional: Pexels API Key for real 1080x1920 stock video B-rolls
PEXELS_API_KEY=

# Optional: YouTube Data API v3 OAuth2 Configuration
YOUTUBE_CLIENT_SECRETS_FILE="client_secrets.json"
YOUTUBE_CREDENTIALS_STORAGE="youtube_token.json"

# Storage Directories
DATABASE_PATH="storage/ai_shorts.db"
TEMP_DIR="storage/temp"
OUTPUT_DIR="storage/output"
ASSETS_DIR="assets"
